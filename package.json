{
    "name": "@dintero/discounts-web-sdk",
    "version": "0.0.0-development",
    "description": "Dintero Discounts SDK for web frontends",
    "main": "dist/dintero-discounts-web-sdk.cjs.js",
    "module": "dist/dintero-discounts-web-sdk.esm.js",
    "umd:main": "dist/dintero-discounts-web-sdk.umd.min.js",
    "unpkg": "dist/dintero-discounts-web-sdk.umd.min.js",
    "types": "dist/dintero-discounts-web-sdk.cjs.d.ts",
    "files": [
        "dist",
        "LISENCE"
    ],
    "tsdown": {
        "suppressWarnings": [
            "TypeScript 7.0 does not yet have a stable API"
        ],
        "hash": false,
        "outputOptions": {
            "entryFileNames": "[name].js"
        },
        "format": {
            "cjs": {
                "entry": {
                    "dintero-discounts-web-sdk.cjs": "src/index.ts"
                },
                "dts": true
            },
            "esm": {
                "entry": {
                    "dintero-discounts-web-sdk.esm": "src/index.ts"
                }
            },
            "umd": {
                "entry": {
                    "dintero-discounts-web-sdk.umd.min": "src/index.ts"
                },
                "globalName": "discounts",
                "minify": true,
                "sourcemap": true
            }
        }
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "lint": "biome check",
        "test": "vitest --dom",
        "watch": "tsdown --watch",
        "semantic-release": "semantic-release",
        "prepublishOnly": "pnpm run build"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Dintero/Dintero.Discounts.Web.SDK.git"
    },
    "homepage": "https://github.com/Dintero/Dintero.Discounts.Web.SDK#readme",
    "author": "Sven Nicolai Viig <sven@dintero.com> (https://dintero.com)",
    "license": "MIT",
    "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
    "bugs": {
        "url": "https://github.com/Dintero/Dintero.Discounts.Web.SDK/issues"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@semantic-release/git": "11.0.1",
        "happy-dom": "21.0.4",
        "semantic-release": "25.0.9",
        "tsdown": "0.23.1",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
